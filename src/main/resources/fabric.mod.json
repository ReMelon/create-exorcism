{
  "schemaVersion": 1,
  "id": "exorcism",
  "version": "${version}",
  "name": "Create: Exorcism",
  "description": "A biblical Create Addon, adding the Bible, Holy Water, and Exorcising to Minecraft",
  "authors": [
    "ReMelon"
  ],
  "contact": {
    "sources": "https://github.com/ReMelon/create-exorcism"
  },
  "license": "MIT",
  "icon": "assets/exorcism/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "remelon.cat.exorcism.Exorcism"
    ],
    "client": [
      "remelon.cat.exorcism.ExorcismClient"
    ],
    "fabric-datagen": [
      "remelon.cat.exorcism.ExorcismDataGen"
    ],
    "emi": [
      "remelon.cat.exorcism.compat.recipe.EMI"
    ],
    "jei_mod_plugin": [
    "remelon.cat.exorcism.compat.recipe.JEI"
    ],
    "rei_client": [
      "remelon.cat.exorcism.compat.recipe.REI"
    ]
  },
  "mixins": [
    "exorcism.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "create": "${create_version}",
    "minecraft": "${minecraft_version}"
  }
}
